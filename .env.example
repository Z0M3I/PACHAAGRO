# ============================================================
# PACHAAGRO — variables de entorno
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local al repositorio.
# ============================================================

# ---------- Aplicación ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=PACHAAGRO

# ---------- Supabase ----------
# Si estas dos variables no están definidas, la aplicación arranca en
# MODO DEMOSTRACIÓN con datos de ejemplo claramente marcados como DEMO.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Se usa para webhooks y tareas administrativas.
# NUNCA exponerla con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- WhatsApp Cloud API (Meta) ----------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=es
# Nombre de las plantillas aprobadas en Meta Business Manager.
WHATSAPP_TEMPLATE_ALERT=alerta_climatica_pachaagro
WHATSAPP_TEMPLATE_MEETING=reunion_comunitaria_pachaagro
WHATSAPP_TEMPLATE_ANNOUNCEMENT=anuncio_agricola_pachaagro
WHATSAPP_TEMPLATE_EDUCATION=contenido_educativo_pachaagro
# Permite probar el flujo sin credenciales. Los mensajes se registran
# como SIMULADOS; nunca se declara un envío real.
WHATSAPP_DEMO_MODE=true

# ---------- Clima ----------
# Fuente oficial boliviana (opcional). Debe exponer el contrato
# normalizado descrito en docs/ARQUITECTURA.md. Si no está configurada,
# se usa Open-Meteo como respaldo y la interfaz lo indica.
SENAMHI_API_URL=
SENAMHI_API_KEY=
WEATHER_PRIMARY_PROVIDER=auto
